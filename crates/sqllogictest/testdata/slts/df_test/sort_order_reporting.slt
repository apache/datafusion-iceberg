# test_sorted_table is sorted by id, and its two data files hold ids 1, 3, 5
# and 2, 3, 4, each recording that sort order.

# Without iceberg.planning.preserve_data_ordering the scan reports no order.
query TT
EXPLAIN SELECT id, name FROM default.default.test_sorted_table ORDER BY id
----
logical_plan
01)Sort: default.default.test_sorted_table.id ASC NULLS LAST
02)--TableScan: default.default.test_sorted_table projection=[id, name]
physical_plan
01)SortExec: expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--CooperativeExec
03)----IcebergTableScan projection:[id,name] predicate:[]

statement ok
SET iceberg.planning.preserve_data_ordering = true

# With it, the scan merges the files in their sort order, and reports it.
query TT
EXPLAIN SELECT id, name FROM default.default.test_sorted_table ORDER BY id
----
logical_plan
01)Sort: default.default.test_sorted_table.id ASC NULLS LAST
02)--TableScan: default.default.test_sorted_table projection=[id, name]
physical_plan
01)CooperativeExec
02)--IcebergTableScan projection:[id,name] predicate:[] output_ordering:[id@0 ASC] files:[2]

query IT
SELECT id, name FROM default.default.test_sorted_table ORDER BY id
----
1 name 1
2 name 2
3 name 3
3 name 3
4 name 4
5 name 5

query IT
SELECT id, name FROM default.default.test_sorted_table ORDER BY id LIMIT 3
----
1 name 1
2 name 2
3 name 3

# A descending sort cannot use the scan's order, so DataFusion sorts the
# merged files again.
query TT
EXPLAIN SELECT id FROM default.default.test_sorted_table ORDER BY id DESC
----
logical_plan
01)Sort: default.default.test_sorted_table.id DESC NULLS FIRST
02)--TableScan: default.default.test_sorted_table projection=[id]
physical_plan
01)SortExec: expr=[id@0 DESC], preserve_partitioning=[false]
02)--CooperativeExec
03)----IcebergTableScan projection:[id] predicate:[] output_ordering:[id@0 ASC] files:[2]

# Tables created through SQL have no sort order, so scans of them report none.
statement ok
CREATE TABLE default.default.test_unsorted_table (id INT NOT NULL, name STRING)

statement ok
INSERT INTO default.default.test_unsorted_table VALUES (2, 'b'), (1, 'a')

query TT
EXPLAIN SELECT id FROM default.default.test_unsorted_table ORDER BY id
----
logical_plan
01)Sort: default.default.test_unsorted_table.id ASC NULLS LAST
02)--TableScan: default.default.test_unsorted_table projection=[id]
physical_plan
01)SortExec: expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--CooperativeExec
03)----IcebergTableScan projection:[id] predicate:[]

# A scan of more files than iceberg.planning.max_merge_files reports no order.
statement ok
SET iceberg.planning.max_merge_files = 1

query TT
EXPLAIN SELECT id, name FROM default.default.test_sorted_table ORDER BY id
----
logical_plan
01)Sort: default.default.test_sorted_table.id ASC NULLS LAST
02)--TableScan: default.default.test_sorted_table projection=[id, name]
physical_plan
01)SortExec: expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--CooperativeExec
03)----IcebergTableScan projection:[id,name] predicate:[]
