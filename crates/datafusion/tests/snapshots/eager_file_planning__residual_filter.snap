---
source: crates/datafusion/tests/eager_file_planning.rs
expression: "format!(\"{plan}\\n{eager_batches}\")"
---
ProjectionExec: expr=[count(Int64(1))@0 as trips]
  AggregateExec: mode=Final, gby=[], aggr=[count(Int64(1))]
    CoalescePartitionsExec
      AggregateExec: mode=Partial, gby=[], aggr=[count(Int64(1))]
        FilterExec: pickup_date@1 = 2024-01-08 AND trip_distance@0 > 50, projection=[]
          RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
            DataSourceExec: format=iceberg, projection=[trip_distance, pickup_date], predicate=(pickup_date = 2024-01-08) AND (trip_distance > 50), planned_files=1

